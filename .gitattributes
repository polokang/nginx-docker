# Default: let Git auto-detect text vs binary, force LF for text on checkout.
* text=auto eol=lf

# Files that MUST be LF (run on Linux containers / scripts)
*.sh         text eol=lf
*.conf       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
Dockerfile   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Common binaries (just in case)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.gz   binary
*.zip  binary
